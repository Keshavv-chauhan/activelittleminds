# Copy this file to .env.local (already gitignored) and fill in the values
# from Firebase console -> Project settings -> Your apps -> Web app -> SDK
# setup and configuration. These identify the project; they are not secret,
# but keeping them out of git means anyone cloning the repo needs their own
# Firebase project before the admin panel or review form will work.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
