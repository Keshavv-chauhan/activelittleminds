rules_version = '2';

// Real access control for the admin panel and the public review form (the
// hidden /admin-login URL is only a UX convenience, not security — this file
// is what actually decides who can read and write what).
service cloud.firestore {
  match /databases/{database}/documents {

    // Membership is "a doc exists at admins/<their uid>". Created by hand in
    // the Firebase console (or via the Admin SDK) — never from the client.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Public review submission: anyone can create one, but only as an
      // unapproved, well-formed review — never pre-approved, never with
      // extra fields, never a wall of text.
      allow create: if request.resource.data.approved == false
        && request.resource.data.quote is string
        && request.resource.data.quote.size() > 0
        && request.resource.data.quote.size() <= 600
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 100
        && (request.resource.data.rating == null
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 1
                && request.resource.data.rating <= 5))
        && request.resource.data.keys().hasOnly(['quote', 'source', 'rating', 'approved', 'createdAt']);

      allow read: if resource.data.approved == true || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      // The "Book a consultation" form. Never publicly readable — this is a
      // visitor's name and phone number — only creatable, and only as a
      // well-formed, unstatused-by-the-submitter entry.
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && (request.resource.data.childAge == null || (request.resource.data.childAge is string && request.resource.data.childAge.size() <= 20))
        && (request.resource.data.service == null || (request.resource.data.service is string && request.resource.data.service.size() <= 100))
        && (request.resource.data.message == null || (request.resource.data.message is string && request.resource.data.message.size() <= 1000))
        && request.resource.data.keys().hasOnly(['name', 'phone', 'childAge', 'service', 'message', 'status', 'createdAt']);

      allow read, update, delete: if isAdmin();
    }
  }
}
